titles.core=["DM–vΩΞ³D+ Core","Inward Q16.16 latent dynamics, measured browser telemetry, and symbolic topology visualization."];

const coreNav=document.createElement("button");
coreNav.dataset.view="core";
coreNav.innerHTML='<span class="nav-icon">⌬</span><span class="nav-label">Core Lattice</span>';
document.querySelector(".nav").appendChild(coreNav);
coreNav.onclick=()=>{showView("core");requestAnimationFrame(resizeCoreCanvas)};

const coreView=document.createElement("div");
coreView.id="view-core";coreView.className="view core-view";
coreView.innerHTML=`
<div class="core-shell">
  <div class="core-head">
    <div><div class="core-head-title">JARVIS-X | DM–vΩΞ³D+ MULTIMODAL CLOUD CORE</div><div class="core-head-sub">INWARD LATENT TRANSFORM | Q16.16 FIXED-POINT | SECURE LOOPBACK CHAT TRANSPORT</div></div>
    <div class="core-symbolic">1000^(1000^(1000^1000)) SYMBOLIC TOPOLOGY<small>Mathematical namespace only — not physically instantiated cores</small></div>
  </div>
  <div class="core-grid">
    <div class="core-column">
