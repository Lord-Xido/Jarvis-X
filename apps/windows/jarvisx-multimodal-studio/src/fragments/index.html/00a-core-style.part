
/* DM-vOmegaXi 3D+ Core Lattice research view */
.core-view{padding:14px;overflow:auto;width:100%;background:radial-gradient(circle at 50% 42%,rgba(77,232,255,.08),transparent 32%),radial-gradient(circle at 68% 48%,rgba(255,98,190,.05),transparent 28%)}
.core-shell{min-height:100%;display:grid;grid-template-rows:auto minmax(540px,1fr) auto;gap:10px;max-width:1540px;margin:0 auto}
.core-head,.core-panel,.core-foot{border:1px solid rgba(77,232,255,.24);border-radius:13px;background:rgba(4,9,20,.88);box-shadow:0 0 24px rgba(77,232,255,.05);backdrop-filter:blur(12px)}
.core-head{padding:11px 14px;display:flex;align-items:center;justify-content:space-between;gap:14px}
.core-head-title{font:800 12px/1.2 Consolas,monospace;letter-spacing:2px;color:var(--cyan)}
.core-head-sub{font:9px/1.4 Consolas,monospace;color:#7389ab;margin-top:4px}
.core-symbolic{text-align:right;font:800 11px/1.25 Consolas,monospace;color:var(--amber);max-width:420px}
.core-symbolic small{display:block;color:#7184a5;font-size:8px;font-weight:400;margin-top:3px}
.core-grid{display:grid;grid-template-columns:260px minmax(360px,1fr) 290px;gap:10px;min-height:0}
.core-column{display:flex;flex-direction:column;gap:10px;min-height:0}
.core-panel{padding:12px;min-height:0}
.core-label{font:8px/1.3 Consolas,monospace;letter-spacing:1.2px;text-transform:uppercase;color:#7187aa}
.core-metric{margin:8px 0 10px}.core-metric strong{display:block;margin-top:3px;font:800 12px/1.25 Consolas,monospace;color:var(--cyan)}
.core-metric strong.magenta{color:var(--magenta)}.core-metric strong.green{color:var(--green)}.core-metric strong.amber{color:var(--amber)}
.core-meter{height:4px;border-radius:99px;background:rgba(255,255,255,.07);overflow:hidden;margin-top:6px}.core-meter>span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--blue),var(--magenta));transition:width .12s linear}
.core-stage{position:relative;overflow:hidden;padding:0;background:radial-gradient(circle,rgba(28,55,90,.24),rgba(2,6,16,.95) 70%)}
#core-canvas{display:block;width:100%;height:100%;min-height:420px;touch-action:none}
.core-stage-overlay{position:absolute;inset:12px 12px auto 12px;display:flex;justify-content:space-between;pointer-events:none;font:8px Consolas,monospace;color:#6f86a9}
.core-stage-overlay b{color:var(--green)}
.core-chat{display:flex;flex-direction:column;height:100%;min-height:0}
#core-messages{flex:1;min-height:160px;overflow:auto;display:flex;flex-direction:column;gap:7px;padding:6px 2px 8px}
.core-msg{max-width:92%;padding:7px 9px;border-radius:8px;font:10px/1.45 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.core-msg.user{align-self:flex-end;border:1px solid rgba(255,98,190,.30);background:rgba(255,98,190,.08);color:#e9d8ff}.core-msg.assistant{align-self:flex-start;border:1px solid rgba(77,232,255,.26);background:rgba(77,232,255,.07);color:#b9f5ff}.core-msg.system{align-self:center;color:#f4d58a;border:1px dashed rgba(255,200,102,.28);font-size:8px;text-align:center}
.core-input{display:flex;gap:6px;margin-top:6px}.core-input input{min-width:0;flex:1;border:1px solid #2d416c;border-radius:9px;background:#050a14;color:var(--text);padding:9px;outline:none;font:10px Consolas,monospace}.core-input input:focus{border-color:var(--cyan)}
.core-quick{display:flex;gap:5px;overflow-x:auto;padding-top:6px}.core-quick button{white-space:nowrap;font-size:8px;padding:5px 7px}
#core-console{height:130px;overflow:auto;margin-top:7px;padding:7px;border:1px solid rgba(255,255,255,.06);border-radius:8px;background:#02050c;font:8px/1.5 Consolas,monospace;color:#7fe6ae;user-select:text}
#core-latent{margin-top:7px;font:8px/1.55 Consolas,monospace;color:#b99cff;overflow-wrap:anywhere;user-select:text}
#core-wave{display:block;width:100%;height:48px;margin-top:7px;border:1px solid rgba(77,232,255,.15);border-radius:7px;background:#02050c}
.core-audio-row{display:flex;gap:6px;margin-top:7px}.core-audio-row button{flex:1;font-size:8px}
.core-law{font:8px/1.6 Consolas,monospace;color:#93a7c5;margin-top:7px}.core-law b{color:var(--amber)}
.core-foot{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;padding:9px 13px;font:8px/1.5 Consolas,monospace;color:#7890b2}.core-foot strong{color:var(--green)}.core-glyph{font-size:25px;color:var(--amber);text-shadow:0 0 18px rgba(255,200,102,.35)}
@media(max-width:1180px){.core-grid{grid-template-columns:220px minmax(320px,1fr)}.core-grid>.core-column:last-child{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr}.core-shell{grid-template-rows:auto auto auto}}
@media(max-width:760px){.core-grid{grid-template-columns:1fr}.core-grid>.core-column:last-child{grid-column:auto;display:flex}.core-head{align-items:flex-start;flex-direction:column}.core-symbolic{text-align:left}.core-foot{grid-template-columns:1fr auto}.core-foot>div:last-child{grid-column:1/-1}.core-stage{min-height:420px}}
