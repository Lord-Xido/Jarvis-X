    "omega_rotate_bits": 1,
    "omega_persistence_mask": 0,
    "pdm_period": 32,
    "max_duty_cycle": 0.9,
    "max_outputs": 64,
    "fixed_point_tolerance": 0.0
  },
  "hardware_limits": {
    "required": true,
    "defaults_provided": false,
    "fields": [
      "max_abs_current_a",
      "max_abs_voltage_v",
      "max_temperature_c",
      "watchdog_timeout_ticks",
      "min_dead_time_ticks"
    ]
  },
  "hardware_io": false,
  "gate_frames_are_logic_intent_only": true,
  "zero_latency_claim": false,
  "fixed_point_scope": "finite internal controller state only"
}
