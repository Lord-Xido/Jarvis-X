FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8090

RUN useradd --create-home --uid 10002 autonomy
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
RUN pip install --no-cache-dir .
USER autonomy
EXPOSE 8090
CMD ["sh", "-c", "uvicorn jarvisx.saas.autonomy.app:app --host 0.0.0.0 --port ${PORT:-8090} --proxy-headers"]
