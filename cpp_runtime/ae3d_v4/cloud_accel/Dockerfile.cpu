FROM python:3.11-slim
WORKDIR /srv/jx
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch>=2.4,<3' && \
    pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1' 'numpy>=1.26,<3' && \
    useradd -r -u 10001 jx
COPY cloud_accel/jx_accel.py cloud_accel/service.py ./
USER 10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 JX_MODEL_PATH=/models/model.jxmodel JX_ACCEL_DEVICE=cpu
EXPOSE 8080
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
